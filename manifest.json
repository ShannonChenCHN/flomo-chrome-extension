{
  "manifest_version": 3,
  "name": "flomo 笔记清空",
  "version": "1.0.0",
  "description": "批量删除 flomo 云端笔记（仅供个人使用）",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://v.flomoapp.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "flomo 笔记清空",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://v.flomoapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
